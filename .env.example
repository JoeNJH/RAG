# Aliyun Bailian / DashScope OpenAI-compatible mode
# Keep API key and base URL unchanged; switch functionality by model name.
OPENAI_API_KEY=sk-a6b6d72324744403ac9bae78decd90d7
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Chat / routing / verifier / judge model
MODEL_NAME=qwen-plus

# Embedding model for Chroma vectorization
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Vision model for image captioning
VISION_MODEL_NAME=qwen-vl-plus

# Chroma settings
CHROMA_DIR=./chroma_db
COLLECTION_NAME=java_programming_kb

# Ingestion settings
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
EMBEDDING_BATCH_SIZE=10
ENABLE_IMAGE_CAPTION=true
ENABLE_OCR=true
ALLOW_FILENAME_IMAGE_FALLBACK=false

# Agent/evaluation settings
USE_LLM_ROUTER=true
USE_LLM_VERIFIER=true
USE_LLM_JUDGE=true
MAX_REPAIR_ATTEMPTS=1
TEMPERATURE=0.2
MAX_TOKENS=900
